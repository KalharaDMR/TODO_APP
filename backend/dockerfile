# 1. Use an official Node environment as a base
FROM node:20-alpine

# 2. Set the working directory inside the container
WORKDIR /app

# 3. Copy package.json and package-lock.json
COPY package*.json ./

# 4. Install dependencies using npm ci
RUN npm ci

# 5. Copy the rest of your backend code
COPY . .

# 6. Expose the port your backend runs on
EXPOSE 5000

# 7. The command to start your backend
CMD ["npm", "start"]
